# Generated by Whiskers from minecraft.tera. Do not edit directly.

from types import SimpleNamespace


class _Colors(list):
    def __init__(self, colors):
        super().__init__(colors)
        for color in colors:
            setattr(self, color.identifier, color)


class _Palette(list):
    def __init__(self, flavors):
        super().__init__(flavors)
        for flavor in flavors:
            setattr(self, flavor.identifier, flavor)


def _color(name, identifier, r, g, b, accent):
    return SimpleNamespace(
        name=name,
        identifier=identifier,
        rgb=SimpleNamespace(r=r, g=g, b=b),
        accent=accent,
    )


PALETTE = _Palette((
{% for flavor_id in ["latte", "frappe", "macchiato", "mocha"] %}    SimpleNamespace(
        name="{{ flavors[flavor_id].name }}",
        identifier="{{ flavor_id }}",
        colors=_Colors((
{% for color_id in ["rosewater", "flamingo", "pink", "mauve", "red", "maroon", "peach", "yellow", "green", "teal", "sky", "sapphire", "blue", "lavender", "text", "subtext1", "subtext0", "overlay2", "overlay1", "overlay0", "surface2", "surface1", "surface0", "base", "mantle", "crust"] %}            _color("{{ flavors[flavor_id].colors[color_id].name }}", "{{ color_id }}", {{ flavors[flavor_id].colors[color_id].rgb.r }}, {{ flavors[flavor_id].colors[color_id].rgb.g }}, {{ flavors[flavor_id].colors[color_id].rgb.b }}, {% if flavors[flavor_id].colors[color_id].accent %}True{% else %}False{% endif %}),
{% endfor %}        )),
    ),
{% endfor %}))
